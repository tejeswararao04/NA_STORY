{
  "expo": {
    "name": "NA Story",
    "slug": "na-story",
    "scheme": "nastory",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#14102B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nastory.app"
    },
    "android": {
      "package": "com.nastory.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14102B"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-image-picker",
      "expo-av"
    ]
  }
}
